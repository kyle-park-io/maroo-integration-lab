# Format of the role wallet file. Scripts read ~/.config/maroo-integration-lab/testnet.env
# (or the path in MAROO_LAB_ENV). `pnpm setup:wallets` creates it with fresh testnet-only keys.
# Keep real keys outside the repository. Values below are placeholders.
BUYER_PRIVATE_KEY=0x<testnet-only private key>
BUYER_ADDRESS=0x<address>
ISSUER_PRIVATE_KEY=0x<testnet-only private key>
ISSUER_ADDRESS=0x<address>
SUPPLIER_A_PRIVATE_KEY=0x<testnet-only private key>
SUPPLIER_A_ADDRESS=0x<address>
SUPPLIER_B_PRIVATE_KEY=0x<testnet-only private key>
SUPPLIER_B_ADDRESS=0x<address>
UPGRADE_OWNER_PRIVATE_KEY=0x<testnet-only private key>
UPGRADE_OWNER_ADDRESS=0x<address>
